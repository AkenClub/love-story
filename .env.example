# Docker Compose configuration only.
# Copy this file to the repository-root .env. The local Node API does not read it;
# pnpm dev:api reads apps/api/.env instead.
WEB_PORT=18080
API_PORT=3000

# required (default) or disabled
AUTH_MODE=required

# Comma-separated high-entropy keys. Required unless AUTH_MODE=disabled.
API_KEYS=lk_live_replace_with_a_long_random_value
